{
  "name": "basic65",
  "displayName": "MEGA65 BASIC 65",
  "description": "Language support for MEGA65 BASIC 65.",
  "version": "0.5.2",
  "publisher": "local",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:basic65"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "mega65",
    "basic65",
    "commodore",
    "basic"
  ],
  "contributes": {
    "commands": [
      {
        "command": "basic65.goToDefinitionOrReferences",
        "title": "BASIC 65: Go to Definition"
      },
      {
        "command": "basic65.findReferences",
        "title": "BASIC 65: Find All References in Document"
      }
    ],
    "keybindings": [
      {
        "command": "basic65.goToDefinitionOrReferences",
        "key": "f12",
        "when": "editorTextFocus && editorLangId == basic65"
      },
      {
        "command": "basic65.findReferences",
        "key": "shift+f2",
        "when": "editorTextFocus && editorLangId == basic65"
      }
    ],
    "languages": [
      {
        "id": "basic65",
        "aliases": [
          "BASIC 65",
          "MEGA65 BASIC"
        ],
        "extensions": [
          ".bas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "basic65",
        "scopeName": "source.basic65",
        "path": "./syntaxes/basic65.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "basic65",
        "path": "./snippets/basic65.json"
      }
    ]
  }
}
